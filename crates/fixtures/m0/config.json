    {
      "Name": "Development Mode",
      "Key": "core/devMode",
      "Description": "In Development Mode, security restrictions are lifted/softened to enable unrestricted access for debugging and testing purposes.",
      "Help": "",
      "Sensitive": false,
      "OptType": 4,
